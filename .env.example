NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace_with_long_random_secret

# Public site URL used for canonical tags, sitemap, Open Graph, and robots.txt
# Example production: https://divinesimparna.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
SITE_URL=http://localhost:3000

MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/?appName=Cluster0

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Places API (Place Details) — optional; requires Google Cloud billing
# This project does NOT need Places API. Reviews are managed in data/google-reviews.ts
GOOGLE_PLACES_API_KEY=
# Optional: used only for the "See all on Google" link
# Find Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---------------------------------------------------------------------------
# Email (Nodemailer + SMTP) — free options that work today
# ---------------------------------------------------------------------------
# Notifications (Contact Us, bookings, newsletter) are sent TO these addresses
# (comma-separated allowed). SMTP_USER is also notified automatically.
SMTP_ADMIN_TO=divinesimparna@gmail.com
CONTACT_NOTIFY_EMAIL=divinesimparna@gmail.com

# From address shown on outbound mail (must match your SMTP mailbox domain):
SMTP_FROM="Divine Simparna Holidays <info@divinesimparna.com>"

# IMPORTANT — deliverability (why Gmail may not show Zoho-sent mail):
# Your domain SPF currently authorizes GoDaddy only:
#   v=spf1 include:secureserver.net -all
# and DMARC is p=quarantine. Sending via Zoho then FAILS SPF, so Gmail
# quarantines/drops the message even when SMTP returns "250 Message received".
#
# Fix in GoDaddy DNS (TXT for divinesimparna.com) — use ONE SPF record:
#   v=spf1 include:zoho.in include:secureserver.net ~all
# Also enable Zoho DKIM in Zoho Mail Admin and add the TXT record Zoho shows.
#
# Until DNS is fixed, use Option B (Gmail App Password) so notifications
# reliably land in divinesimparna@gmail.com.

# --- Option A: Zoho Mail (needs SPF/DKIM for Gmail delivery) ---
# SMTP_HOST=smtp.zoho.in
# SMTP_PORT=465
# SMTP_USER=info@yourdomain.com
# SMTP_PASS=your_zoho_app_password_or_mailbox_password

# --- Option B: Gmail Free (App Password; best for inboxing to Gmail now) ---
# 1) Enable 2FA on the Gmail account
# 2) Create App Password: https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=divinesimparna@gmail.com
# SMTP_PASS=your_16_char_app_password
# SMTP_FROM="Divine Simparna Holidays <divinesimparna@gmail.com>"

# --- Option C: Elastic Email Free tier ---
# SMTP_HOST=smtp.elasticemail.com
# SMTP_PORT=2525
# SMTP_USER=your_elastic_username
# SMTP_PASS=your_elastic_api_key

# Active SMTP credentials (fill one of the options above):
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Later: to move to a paid API (e.g. Resend), keep the same SMTP_ADMIN_TO /
# CONTACT_NOTIFY_EMAIL and swap the transport in lib/mail.ts — call sites stay the same.
